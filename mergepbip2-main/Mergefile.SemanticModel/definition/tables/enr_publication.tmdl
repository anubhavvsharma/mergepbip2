	column 'OA Group' =
			VAR OAStatus =
				SUBSTITUTE (
					LOWER ( TRIM ( COALESCE ( [open_access_status], "closed" ) ) ),
					"oa_all|",
					""
				)
			RETURN
				IF (
					OAStatus IN { "gold", "hybrid", "bronze", "green", "open" },
					"Open",
					"Closed"
				)
		dataType: string
		lineageTag: 7719d345-d68a-4d18-a8d0-315c11bed096
		summarizeBy: none
		sortByColumn: 'OA Group Sort'

		annotation SummarizationSetBy = User

	column 'OA Group Sort' =
			VAR OAStatus =
				SUBSTITUTE (
					LOWER ( TRIM ( COALESCE ( [open_access_status], "closed" ) ) ),
					"oa_all|",
					""
				)
			RETURN
				IF (
					OAStatus IN { "gold", "hybrid", "bronze", "green", "open" },
					1,
					2
				)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: be619726-0ae8-4394-8248-cf673cb6483d
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Mix Axis' = "All publications"
		dataType: string
		isHidden
		lineageTag: eadcf7b7-381d-4f03-be19-3418549a88ad
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Primary Product' =
			VAR PublicationText = LOWER ( COALESCE ( enr_publication[tactic_title], "" ) & " " & COALESCE ( enr_publication[abstract], "" ) )
			RETURN MAXX ( TOPN ( 1, FILTER ( ProductKeywordMapping, CONTAINSSTRING ( PublicationText, ProductKeywordMapping[Keyword] ) ), ProductKeywordMapping[Priority], ASC ), ProductKeywordMapping[Primary Product] )
		dataType: string
		lineageTag: e330e864-8ee3-46bb-8100-6eb9c7c4053b
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Managed by' =
			VAR Countries = TRIM ( COALESCE ( enr_publication[research_org_countries], "" ) )
			VAR CountryCount = IF ( Countries = "", 0, 1 + LEN ( Countries ) - LEN ( SUBSTITUTE ( Countries, "|", "" ) ) )
			RETURN SWITCH ( TRUE, CountryCount = 0, BLANK (), CountryCount = 1, "Local", CountryCount = 2, "Regional", "Global" )
		dataType: string
		lineageTag: f6d9e432-9112-4930-aa62-51720f626da2
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'DOCUMENT TITLE' =
			VAR FullTitle = TRIM ( COALESCE ( [tactic_title], "" ) )
			VAR SearchTitle = LOWER ( FullTitle )
			VAR ShortTitle =
				SWITCH (
					TRUE (),
					CONTAINSSTRING ( SearchTitle, "dreamm-8" ), "DREAMM-8 readout",
					CONTAINSSTRING ( SearchTitle, "dreamm-2" ) && CONTAINSSTRING ( SearchTitle, "13-month" ), "DREAMM-2 13-month",
					CONTAINSSTRING ( SearchTitle, "dreamm-2" ) && CONTAINSSTRING ( SearchTitle, "final" ), "DREAMM-2 final analysis",
					CONTAINSSTRING ( SearchTitle, "dreamm-3" ), "DREAMM-3 phase 3",
					CONTAINSSTRING ( SearchTitle, "immunogenic cell death" ), "Immunogenic cell death",
					CONTAINSSTRING ( SearchTitle, "corneal" ), "Corneal event management",
					CONTAINSSTRING ( SearchTitle, "treatment pattern" ) || CONTAINSSTRING ( SearchTitle, "rrmm treatment" ), "RRMM treatment patterns",
					CONTAINSSTRING ( SearchTitle, "dreamm-2" ), "DREAMM-2 primary",
					IF ( LEN ( FullTitle ) > 44, LEFT ( FullTitle, 41 ) & "...", FullTitle )
				)
			RETURN
				ShortTitle
					& IF (
						NOT ISBLANK ( [journal_title_raw] ) && TRIM ( [journal_title_raw] ) <> "",
						UNICHAR ( 10 ) & TRIM ( [journal_title_raw] ),
						""
					)
		dataType: string
		lineageTag: 01886744-0623-447f-9a91-7b5a1656cb8e
		summarizeBy: none

		annotation SummarizationSetBy = User

	column YEAR = [publication_year]
		dataType: int64
		formatString: 0
		lineageTag: 1e9b7f56-5c27-4101-8995-0909297274ed
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Publication Short Name' =
			VAR FullTitle = TRIM ( COALESCE ( enr_publication[tactic_title], "" ) )
			VAR ColonPosition = SEARCH ( ":", FullTitle, 1, 0 )
			VAR DashPosition = SEARCH ( " - ", FullTitle, 1, 0 )
			VAR FirstDelimiter =
				SWITCH (
					TRUE (),
					ColonPosition > 0 && DashPosition > 0, MIN ( ColonPosition, DashPosition ),
					ColonPosition > 0, ColonPosition,
					DashPosition > 0, DashPosition,
					0
				)
			VAR DelimitedLabel = IF ( FirstDelimiter > 4, TRIM ( LEFT ( FullTitle, FirstDelimiter - 1 ) ) )
			VAR FourthSpace = SEARCH ( "|", SUBSTITUTE ( FullTitle, " ", "|", 4 ), 1, 0 )
			VAR FourWordLabel = IF ( FourthSpace > 0, LEFT ( FullTitle, FourthSpace - 1 ), FullTitle )
			RETURN
				IF (
					FullTitle = "",
					BLANK (),
					COALESCE ( DelimitedLabel, FourWordLabel, FullTitle )
				)
