	measure 'Cited Publications Subtitle' = FORMAT ( [Cited Publications], "#,0" ) & " of " & FORMAT ( [Publications], "#,0" ) & " publications cited"
		lineageTag: 9031e1de-b84f-4cab-a173-87807e52c465

	measure 'OA Mix Note' = FORMAT ( [Open Access Publications], "#,0" ) & " of " & FORMAT ( [Publications], "#,0" ) & " open"
		lineageTag: 259543f6-cc27-4571-b8cb-8fb10d822e8d

	measure 'OA Group Share %' = DIVIDE ( [Publications], CALCULATE ( [Publications], ALLSELECTED ( enr_publication[OA Group] ) ), 0 )
		formatString: 0.0%
