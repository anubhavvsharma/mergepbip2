	measure 'Publication Detail Subtitle' = "all years · " & FORMAT ( [Publications], "#,0" ) & " records in the source extract"
		lineageTag: b9065016-a62a-476c-a644-79b53cc2d4ee

	measure 'Citation Detail Serial' =
			VAR CurrentName = SELECTEDVALUE ( enr_publication[Publication Short Name] )
			VAR CurrentJournal = SELECTEDVALUE ( enr_publication[journal_title_raw] )
			VAR CurrentYear = SELECTEDVALUE ( enr_publication[publication_year] )
			VAR CurrentValue = [Total Citations]
			VAR Candidates =
				CALCULATETABLE (
					ADDCOLUMNS (
						SUMMARIZE ( enr_publication, enr_publication[Publication Short Name], enr_publication[journal_title_raw], enr_publication[publication_year] ),
						"@Citations", CALCULATE ( [Total Citations] )
					),
					ALLSELECTED ( enr_publication[Publication Short Name], enr_publication[journal_title_raw], enr_publication[publication_year] )
				)
			VAR Serial = 1 + COUNTROWS (
				FILTER ( Candidates,
					[@Citations] > CurrentValue ||
					( [@Citations] = CurrentValue &&
						( enr_publication[Publication Short Name] < CurrentName ||
							( enr_publication[Publication Short Name] = CurrentName && enr_publication[journal_title_raw] < CurrentJournal ) ||
							( enr_publication[Publication Short Name] = CurrentName && enr_publication[journal_title_raw] = CurrentJournal && enr_publication[publication_year] < CurrentYear ) ) )
				)
			)
			RETURN IF ( ISINSCOPE ( enr_publication[Publication Short Name] ) && NOT ISBLANK ( CurrentValue ), Serial )
		formatString: 0
		lineageTag: b93fee25-215f-4c45-8eaa-1e3891d39fff

	measure 'Show Citation Detail Top 20' = IF ( NOT ISBLANK ( [Citation Detail Serial] ) && [Citation Detail Serial] <= 20, 1, 0 )
		formatString: 0
		lineageTag: 057f1185-b8c1-449e-b262-f7e1302ba7f3

	measure 'MCP Record ID' =
			VAR Records = ADDCOLUMNS ( VALUES ( enr_publication[dimensions_id] ), "@Value", CALCULATE ( [Ranking Citation Value] ) )
			RETURN MAXX ( TOPN ( 1, Records, [@Value], DESC, enr_publication[dimensions_id], ASC ), enr_publication[dimensions_id] )
		lineageTag: d15fdc06-7d5d-44b2-82ec-a2d58d069ad2

	measure 'MCP Record Title' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( SELECTEDVALUE ( enr_publication[tactic_title] ), KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		lineageTag: af85ae8d-62f2-4a06-987c-bc5ed898c396

	measure 'MCP Record Journal' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( SELECTEDVALUE ( enr_publication[journal_title_raw] ), KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		lineageTag: 8c406a8f-8130-401f-af2c-56e5b21337c7

	measure 'MCP Record Year' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( SELECTEDVALUE ( enr_publication[publication_year] ), KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		formatString: 0
		lineageTag: f765a096-6c0b-4b54-982c-0d128beb0a3a

	measure 'MCP Priority' =
			VAR Products = VALUES ( enr_publication[Primary Product] )
			RETURN CALCULATE ( SELECTEDVALUE ( dim_Product[Priority Label], "Multiple" ), TREATAS ( Products, dim_Product[Primary Product] ) )
		lineageTag: 4e62c00e-9809-47ea-8e2b-8aa5dd06a95d

	measure 'MCP Record Priority' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( [MCP Priority], KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		lineageTag: f4697831-68a7-40a6-aaf2-78705528f36e

	measure 'MCP Record OA' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( SELECTEDVALUE ( enr_publication[open_access_status], "Unavailable" ), KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		lineageTag: 9ae4c38f-5c13-4a49-953b-b63370a4bdc4

	measure 'MCP Record Licence' = "Not available in source"
		lineageTag: 3a52ab5e-4797-48b5-acd2-d72139134d0f

	measure 'MCP Record Total' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( [Total Citations], KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		formatString: #,0
		lineageTag: 4a038e92-7e3d-4d5c-801b-dcc68b89ea09

	measure 'MCP Record Recent' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( [Recent Citations], KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		formatString: #,0
		lineageTag: 500e9b32-f705-45d7-baf0-f8c6f8543812

	measure 'MCP Record Share' = DIVIDE ( [MCP Record Recent], [MCP Record Total], 0 )
		formatString: 0%
		lineageTag: 0a0e1889-b398-4b1a-b85c-5c4a31e7e894

	measure 'MCP Record Attention' = VAR SelectedPublicationID = [MCP Record ID] RETURN CALCULATE ( [Publication Attention Score], KEEPFILTERS ( enr_publication[dimensions_id] = SelectedPublicationID ) )
		formatString: #,0
		lineageTag: ebf80d85-98f2-4a89-8166-f9ed315a3155

	measure 'MCP Record Share Remaining' = MAX ( 0, 1 - [MCP Record Share] )
		formatString: 0%
		lineageTag: 3f3754bc-a9db-4750-9c14-30b5b833f7b0

	measure 'MCP Recent Window Caption' =
			VAR LatestCitingYear = CALCULATE ( MAX ( enr_pub_citing_publication[pub_year] ), REMOVEFILTERS ( enr_pub_citing_publication ) )
			RETURN IF ( ISBLANK ( LatestCitingYear ), "Recent citation window unavailable", "Recent = citations from " & FORMAT ( LatestCitingYear - 1, "0" ) & " onward" )
		lineageTag: 1d6760c1-96d5-45bf-bc1f-bb95ef3723ee

	measure 'Citation Year Color' =
			VAR LatestYear = CALCULATE ( MAX ( enr_publication[publication_year] ), REMOVEFILTERS ( enr_publication[publication_year] ), REMOVEFILTERS ( 'Date'[Year] ) )
			RETURN IF ( SELECTEDVALUE ( enr_publication[publication_year] ) = LatestYear, "#F58220", "#CFCDC6" )
		lineageTag: c699ae1f-e445-4ca7-8613-7a62fd4989bb

