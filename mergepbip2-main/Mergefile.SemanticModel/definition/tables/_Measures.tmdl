	measure 'Median Citations' =
			MEDIANX (
				FILTER ( VALUES ( enr_publication[dimensions_id] ), NOT ISBLANK ( enr_publication[dimensions_id] ) ),
				CALCULATE ( [Total Citations] )
			)
		formatString: #,0.0
		lineageTag: 3c2cbe8b-c3b4-44f7-8c62-09bb3a13cc88

	measure 'Previous Years Citations' =
			VAR LatestVisibleYear =
				CALCULATE (
					MAX ( enr_publication[publication_year] ),
					REMOVEFILTERS ( 'Date'[Year] ),
					REMOVEFILTERS ( enr_publication[publication_year] )
				)
			VAR AxisYear = SELECTEDVALUE ( enr_publication[publication_year] )
			RETURN IF ( NOT ISBLANK ( AxisYear ) && AxisYear < LatestVisibleYear, [Total Citations] )
		formatString: #,0
		lineageTag: aa1673f7-a2a7-4084-b797-18cf5cba76b1

	measure 'Current Year Citations' =
			VAR LatestVisibleYear =
				CALCULATE (
					MAX ( enr_publication[publication_year] ),
					REMOVEFILTERS ( 'Date'[Year] ),
					REMOVEFILTERS ( enr_publication[publication_year] )
				)
			RETURN IF ( SELECTEDVALUE ( enr_publication[publication_year] ) = LatestVisibleYear, [Total Citations] )
		formatString: #,0
		lineageTag: 3d426244-bfc7-4a15-8937-ea05b22e880c

	measure 'Median per Publication' = [Median Citations]
		formatString: #,0.0
