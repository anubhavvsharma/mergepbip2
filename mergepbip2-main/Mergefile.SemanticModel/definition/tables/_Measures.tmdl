	measure 'Cited Publications %' = DIVIDE ( [Cited Publications], [Publications] )
		formatString: 0.0%
		lineageTag: 03768397-b2bf-4ca9-b5be-85d8e2e1d7ac

	measure 'Publication Count by Year' = [Publications]
		formatString: #,0
		lineageTag: 6c83fd26-012e-4f82-ad00-50936c429454

	measure 'Latest Data Date' = MAX ( enr_publication[tactic_date] )
		formatString: dd mmm yyyy
