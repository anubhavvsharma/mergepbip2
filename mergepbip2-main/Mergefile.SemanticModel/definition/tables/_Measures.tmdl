	measure 'Previous Years Recent Citations' =
			VAR LatestVisibleYear =
				CALCULATE (
					MAX ( enr_publication[publication_year] ),
					REMOVEFILTERS ( 'Date'[Year] ),
					REMOVEFILTERS ( enr_publication[publication_year] )
				)
			VAR AxisYear = SELECTEDVALUE ( enr_publication[publication_year] )
			RETURN IF ( NOT ISBLANK ( AxisYear ) && AxisYear < LatestVisibleYear, [Recent Citations] )
		formatString: #,0
		lineageTag: 2fc6837e-c223-4844-b2a7-d76021b4c67b

	measure 'Current Year Recent Citations' =
