	measure 'Top N Citations Subtitle' = FORMAT ( [Top N Citation Share %], "0%" ) & " of all citations"
		lineageTag: 453aa709-3a5f-4630-85f9-559917a91c55

	measure 'Top N Recent Citations' =
			VAR PublicationSummary =
