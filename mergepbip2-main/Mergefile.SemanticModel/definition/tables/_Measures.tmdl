					"@RankValue", CALCULATE ( [Ranking Citation Value] ),
					"@RecentCitations", CALCULATE ( [Recent Citations] )
				)
			VAR TopPublications = TOPN ( [Selected Rank N], PublicationSummary, [@RankValue], DESC, enr_publication[dimensions_id], ASC )
			RETURN SUMX ( TopPublications, [@RecentCitations] )
		formatString: #,0
		lineageTag: 55617ae0-7e2a-42c3-bdc9-42c082f85f98

	measure 'Top N Recent Citation Share %' = DIVIDE ( [Top N Recent Citations], CALCULATE ( [Recent Citations], ALLSELECTED ( enr_publication ) ), 0 )
		formatString: 0%
