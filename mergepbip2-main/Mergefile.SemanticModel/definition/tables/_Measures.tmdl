	measure 'Portfolio Recent Publications' = VAR RecentYear = YEAR ( TODAY () ) - 1 RETURN COALESCE ( CALCULATE ( [Publications], REMOVEFILTERS ( 'Date' ), enr_publication[publication_year] = RecentYear ), 0 )
		formatString: #,0
