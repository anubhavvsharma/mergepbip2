table _Measures
	lineageTag: 76179b38-b545-4393-beca-dfcb35635251

	measure Publications = DISTINCTCOUNT ( enr_publication[dimensions_id] )
		formatString: #,0
		lineageTag: 04bd5f56-d7ad-4bcb-9cf7-725f9a8683a4

	measure 'Publications Last 12 Months' =
			VAR EndDate = TODAY ()
			RETURN
				CALCULATE (
					[Publications],
					DATESINPERIOD ( 'Date'[Date], EndDate, -12, MONTH )
				)
		formatString: #,0
		lineageTag: 6237cdfb-2b80-479f-b213-df7a74b46b41

	measure 'Previous 12 Months Publications' =
			VAR EndDate = EDATE ( TODAY (), -12 )
			RETURN
				CALCULATE (
					[Publications],
					DATESINPERIOD ( 'Date'[Date], EndDate, -12, MONTH )
				)
		formatString: #,0
		lineageTag: 9d249caf-84ed-4d83-8165-fd44c986c6b0

	measure 'Last 12 Months Change %' = DIVIDE ( [Publications Last 12 Months] - [Previous 12 Months Publications], [Previous 12 Months Publications] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 723044d1-46af-44fa-842c-aa0d046efce9

	measure 'Total Journals' = DISTINCTCOUNT ( enr_publication[journal_title_raw] )
		formatString: #,0
		lineageTag: 09f9537d-45c5-4275-a820-7437bd159dd7

	measure 'Open Access Publications' =
			CALCULATE (
				[Publications],
				enr_publication[open_access_status] IN { "oa_all|gold", "oa_all|hybrid", "oa_all|bronze", "oa_all|green" }
			)
		formatString: #,0
		lineageTag: 93b52cae-a844-4020-8cce-0591cdd14ea2

	measure 'Open Access %' = DIVIDE ( [Open Access Publications], [Publications] )
		formatString: 0.0%
		lineageTag: b3d0c490-7491-4ae7-8c93-3e7ca5fc2772

	measure 'Publication Type Count' = [Publications]
		formatString: #,0
		lineageTag: 215d4af3-20b9-44ae-90b4-5efb56039ceb

	measure 'Publication Type Share %' = DIVIDE ( [Publication Type Count], CALCULATE ( [Publications], REMOVEFILTERS ( enr_publication[publication_type] ) ) )
		formatString: 0.0%
		lineageTag: 30754d2d-7c8b-4bf6-a30f-232571a6d670

	measure 'Publication Share %' = [Publication Type Share %]
		formatString: 0.0%
		lineageTag: ee2dd4cb-ccec-480b-99ef-8809c79488dc

	measure 'Total Citations' =
			COUNTROWS (
				SUMMARIZE (
					enr_pub_citing_pub_link,
					enr_pub_citing_pub_link[original_dimensions_id],
					enr_pub_citing_pub_link[citing_dimensions_id]
				)
			)
		formatString: #,0
		lineageTag: b937db53-f03b-463d-9d91-eed59272c0df

	measure 'Cited Publications' = DISTINCTCOUNT ( enr_pub_citing_pub_link[original_dimensions_id] )
		formatString: #,0
