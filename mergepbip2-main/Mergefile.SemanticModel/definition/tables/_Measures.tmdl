	measure 'Year Coverage Label' = "Publications and citations by year · " & FORMAT ( MIN ( enr_publication[publication_year] ), "0" ) & "–" & FORMAT ( MAX ( enr_publication[publication_year] ), "0" ) & " coverage"
		lineageTag: 17c48ed2-ed2a-49d4-ad83-02b729a662c7

	measure 'Data As Of Label' = "Data as of " & FORMAT ( [Latest Data Date], "dd mmm yyyy" )
		lineageTag: c0d5e44e-5434-4bb6-b3df-b9bcb5309437

	measure 'Data As Of' = [Data As Of Label]
		lineageTag: 8f715bfa-bc7b-45e7-b743-41425284c54f

	measure 'Open Access Summary' = FORMAT ( [Open Access Publications], "#,0" ) & " of " & FORMAT ( [Publications], "#,0" ) & " publications are open"
		lineageTag: dbe68049-a7e9-4c77-8b80-c14cad38e29f

	measure 'Peak Publications' = MAXX ( ALLSELECTED ( 'Date'[Year] ), CALCULATE ( [Publications] ) )
		formatString: #,0
		lineageTag: df509cf4-4f80-446c-a35d-66a9c840a7d0

	measure 'Peak Publication Year' = MAXX ( TOPN ( 1, ADDCOLUMNS ( ALLSELECTED ( 'Date'[Year] ), "@Publications", CALCULATE ( [Publications] ) ), [@Publications], DESC, 'Date'[Year], ASC ), 'Date'[Year] )
		formatString: 0
		lineageTag: c6196536-f9fe-417d-9643-41318cc43de8

	measure 'Trend Insight' = "Output peaked at " & FORMAT ( [Peak Publications], "#,0" ) & " publications in " & FORMAT ( [Peak Publication Year], "0" ) & "."
		lineageTag: f76fb203-a6c4-4dd2-91d9-c571613fe134

	measure 'Uncited Publications' = MAX ( 0, [Publications] - [Cited Publications] )
		formatString: #,0
		lineageTag: 916215ea-de42-4ffe-8f25-361d7532b652

	measure 'Recent Citations' = VAR LatestCitingYear = CALCULATE ( MAX ( 'enr_pub_citing_publication'[pub_year] ), REMOVEFILTERS ( 'enr_pub_citing_publication' ) ) VAR RecentCitingPublications = CALCULATETABLE ( VALUES ( 'enr_pub_citing_publication'[citing_dimensions_id] ), REMOVEFILTERS ( 'enr_pub_citing_publication' ), 'enr_pub_citing_publication'[pub_year] >= LatestCitingYear - 1 ) RETURN COALESCE ( CALCULATE ( COUNTROWS ( SUMMARIZE ( 'enr_pub_citing_pub_link', 'enr_pub_citing_pub_link'[original_dimensions_id], 'enr_pub_citing_pub_link'[citing_dimensions_id] ) ), TREATAS ( RecentCitingPublications, 'enr_pub_citing_pub_link'[citing_dimensions_id] ) ), 0 )
		formatString: #,##0
		lineageTag: 3564b2eb-1d71-49ca-a07e-34b8548fb4f0

	measure 'Recent Citations %' = DIVIDE ( [Recent Citations], [Total Citations], 0 )
