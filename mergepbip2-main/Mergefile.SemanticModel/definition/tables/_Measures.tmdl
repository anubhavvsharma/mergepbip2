	measure 'Open Access Subtitle' = FORMAT ( [Open Access Publications], "#,0" ) & " of " & FORMAT ( [Publications], "#,0" ) & " publications freely accessible"
		lineageTag: 3d1d9fe8-4ec9-4e56-aa70-e55ee92191e4

	measure 'Total Citations Subtitle' = "across " & FORMAT ( [Publications], "#,0" ) & " publications"
