	measure 'Selected Rank N' = COALESCE ( SELECTEDVALUE ( MostCitedRankRange[Top N] ), 10 )
		formatString: #,0
		lineageTag: 05c8433a-7e4f-4f4e-b16b-4842ad5ccbbc

	measure 'Selected Citation Window' = SELECTEDVALUE ( CitationWindow[Citation Window], "All time" )
		lineageTag: 8688d01c-fb7c-4d35-b7f5-cc6af141f64d

	measure 'Selected Rank Range Label' = SELECTEDVALUE ( MostCitedRankRange[Rank Range], "Top 10" )
		lineageTag: 733ed8e6-42df-4e8c-bc74-d5d60c974353

	measure 'Top N Citations Title' = [Selected Rank Range Label] & " Citations"
		lineageTag: 10f07b7e-cf9b-4664-805d-4543e88b7065

	measure 'Top N Recent Citations Title' = [Selected Rank Range Label] & " Recent Citations"
		lineageTag: 7fd022c4-8936-47c4-9b0c-15a76585165a

	measure 'Ranking Citation Value' = SWITCH ( [Selected Citation Window], "Recent citations", [Recent Citations], [Total Citations] )
		formatString: #,0
		lineageTag: cc6c18f3-2182-4c2a-9cc7-15088deeb4ef

	measure 'Publication Rank' =
			VAR CurrentCitationValue = [Ranking Citation Value]
			VAR PublicationsToRank =
				CALCULATETABLE (
					VALUES ( enr_publication[dimensions_id] ),
					ALLSELECTED ( enr_publication ),
					NOT ISBLANK ( enr_publication[Primary Product] )
				)
			VAR SelectedYears = ALLSELECTED ( enr_publication[publication_year] )
			RETURN
				IF (
					NOT ISBLANK ( CurrentCitationValue ),
					RANKX (
						PublicationsToRank,
						CALCULATE (
							[Ranking Citation Value],
							REMOVEFILTERS (
								enr_publication[DOCUMENT TITLE],
								enr_publication[tactic_title],
								enr_publication[journal_title_raw],
								enr_publication[YEAR],
								enr_publication[publication_year]
							),
							KEEPFILTERS ( SelectedYears )
						),
						CurrentCitationValue,
						DESC,
						DENSE
					)
				)
		formatString: 0
		lineageTag: b700341a-35c8-41ad-9da8-e78abb06f020

	measure 'Show Publication in Rank Range' = IF ( NOT ISBLANK ( SELECTEDVALUE ( enr_publication[Primary Product] ) ) && NOT ISBLANK ( [Publication Rank] ) && [Publication Rank] <= [Selected Rank N], 1, 0 )
		formatString: 0
		lineageTag: 9627673f-518f-4bb8-989f-d5d9fe93d167

	measure 'Most Cited Publication Citations' =
			VAR RankedPublications =
				ADDCOLUMNS (
					CALCULATETABLE ( VALUES ( enr_publication[dimensions_id] ), ALLSELECTED ( enr_publication ) ),
					"@CitationValue", CALCULATE ( [Ranking Citation Value] )
				)
			RETURN MAXX ( RankedPublications, [@CitationValue] )
		formatString: #,0
		lineageTag: b2b8f07e-8a8a-47d7-a918-1cf0f07fe087

	measure 'Most Cited Publication Subtitle' =
			VAR PublicationSummary =
				ADDCOLUMNS (
					SUMMARIZE (
						ALLSELECTED ( enr_publication ),
						enr_publication[dimensions_id],
						enr_publication[tactic_title],
						enr_publication[publication_year]
					),
					"@CitationValue", CALCULATE ( [Ranking Citation Value] )
				)
			VAR TopPublication = TOPN ( 1, PublicationSummary, [@CitationValue], DESC, enr_publication[tactic_title], ASC )
			RETURN CONCATENATEX ( TopPublication, enr_publication[tactic_title] & " · " & FORMAT ( enr_publication[publication_year], "0" ), "" )
		lineageTag: 7ae9cf2c-1ef6-4425-972e-8e160f31783c

	measure 'Top N Citations' =
			VAR PublicationSummary =
				ADDCOLUMNS (
					CALCULATETABLE ( VALUES ( enr_publication[dimensions_id] ), ALLSELECTED ( enr_publication ) ),
					"@RankValue", CALCULATE ( [Ranking Citation Value] ),
					"@TotalCitations", CALCULATE ( [Total Citations] )
				)
			VAR TopPublications = TOPN ( [Selected Rank N], PublicationSummary, [@RankValue], DESC, enr_publication[dimensions_id], ASC )
			RETURN SUMX ( TopPublications, [@TotalCitations] )
		formatString: #,0
		lineageTag: 8a64e110-320e-4fe6-b031-1732645706e0

	measure 'Top N Citation Share %' = DIVIDE ( [Top N Citations], CALCULATE ( [Total Citations], ALLSELECTED ( enr_publication ) ), 0 )
		formatString: 0%
